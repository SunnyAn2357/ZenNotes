# ========================================================
# 온라인개인용 .gitignore (웹 런타임 순수 격리 방어막)
# ========================================================

# 1. 백업 및 데이터 파일
*.bak
*.dday
*.old
*.backup
*.tmp
*.log

# 2. 개발 문서 및 텍스트 (웹 실행 불필요 비실행 파일)
*.md
*.txt
*.pdf

# 3. 로컬 스크립트 및 빌드/배포 설정
*.bat
*.cmd
*.ps1
*.iss

# 4. 사내 보안 라이선스 / 인증서 / 데스크톱 바이너리
*.ads_cert
*.pfx
*.cer
*.exe
*.dll
src-desktop/
dist/
Backups/
V*.*/

# 5. Firebase 런타임 캐시 및 OS 메타데이터
.firebase/
.DS_Store
Thumbs.db
desktop.ini
